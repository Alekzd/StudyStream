# StudyStream — Environment Variables Template
# Copy this file to .env.local and fill in the values

# ─── CLERK AUTHENTICATION ────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# After-sign-in/up redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook — Get from: Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# Clerk JWT Issuer — Get from: Clerk Dashboard → JWT Templates → "convex" → Issuer URL
CLERK_JWT_ISSUER_DOMAIN=https://YOUR-INSTANCE.clerk.accounts.dev

# ─── CONVEX BACKEND ──────────────────────────────────────────────────
# Run: npx convex dev → copy the URL from the dashboard
NEXT_PUBLIC_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
CONVEX_DEPLOYMENT=dev:YOUR-DEPLOYMENT

# ─── LIVEKIT WEBRTC SFU ──────────────────────────────────────────────
# Phase 1 (< 20 CCU): Use LiveKit Cloud Free Tier
# Sign up at: https://cloud.livekit.io → Create Project → Copy keys
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=REPLACE_WITH_SECRET
NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Phase 2 (100-150 CCU): Self-hosted on Oracle Cloud Always Free
# Change ONLY this URL — no code changes needed!
# NEXT_PUBLIC_LIVEKIT_WS_URL=wss://your-oracle-vps-ip:7880

# ─── APP ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
